import React, { useMemo, useRef, useState } from 'react';
import styled from '@emotion/styled';
import { motion } from 'framer-motion';
import { ActivityChartSectionProps } from './types';
import { useAnimationEngine } from '@/utils/ui/animation';

// === 布局 ===
const ChartSection = styled(motion.section)`
  margin: 4.5rem 0 2.5rem;
`;

const SectionHeader = styled.div`
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 1.5rem;
  flex-wrap: wrap;
  margin: 0 0 2.25rem;

  @media (max-width: 768px) {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
`;

// 等宽注释体标题，呼应全站 // 母题
const SectionTitle = styled(motion.h2)`
  font-family: var(--font-mono);
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0 0 0.5rem 0;
  letter-spacing: 0.02em;

  &::before {
    content: '// ';
    color: var(--accent-color);
  }
`;

const SectionSubtitle = styled(motion.p)`
  font-size: 0.95rem;
  color: var(--text-secondary);
  margin: 0;
  opacity: 0.85;
  line-height: 1.6;
`;

// 数据摘要条
const StatsRow = styled(motion.div)`
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;

  @media (max-width: 768px) {
    gap: 1.25rem;
  }
`;

const StatItem = styled.div`
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
`;

const StatValue = styled.span`
  font-family: var(--font-mono);
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--accent-color);
  line-height: 1.2;
`;

const StatLabel = styled.span`
  font-size: 0.8rem;
  color: var(--text-tertiary);
  letter-spacing: 0.05em;
`;

// 图表容器
const ChartWrapper = styled.div`
  position: relative;
  margin-top: 0.5rem;
`;

const SvgChart = styled.svg`
  display: block;
  width: 100%;
  height: auto;
  overflow: visible;
  cursor: crosshair;
`;

// hover 浮层
const Tooltip = styled(motion.div)`
  position: absolute;
  top: 0;
  transform: translateX(-50%);
  background: var(--bg-secondary);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 0.4rem 0.65rem;
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-primary);
  white-space: nowrap;
  pointer-events: none;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  z-index: 10;

  .count {
    color: var(--accent-color);
    font-weight: 600;
  }
`;

// 月份刻度
const MonthTicks = styled.div`
  position: relative;
  height: 1.25rem;
  margin-top: 0.75rem;
  border-top: 1px solid transparent;
`;

const MonthTick = styled.span<{ pct: number; anchor: 'start' | 'middle' | 'end' }>`
  position: absolute;
  top: 0.35rem;
  left: ${(props) => props.pct * 100}%;
  transform: translateX(
    ${(props) => (props.anchor === 'middle' ? '-50%' : props.anchor === 'end' ? '-100%' : '0')}
  );
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-tertiary);
  opacity: 0.7;
  letter-spacing: 1px;
`;

// === 工具函数 ===
// 7 日滑动平均，让波形有诗意而非每日抖动
const smooth = (values: number[], window = 7): number[] => {
  const half = Math.floor(window / 2);
  return values.map((_, i) => {
    let sum = 0;
    let n = 0;
    for (let j = i - half; j <= i + half; j++) {
      if (j >= 0 && j < values.length) {
        sum += values[j];
        n++;
      }
    }
    return sum / n;
  });
};

// Catmull-Rom 转三次贝塞尔，生成平滑曲线
const buildSmoothPath = (pts: { x: number; y: number }[]): string => {
  if (pts.length < 2) return '';
  let d = `M ${pts[0].x.toFixed(2)},${pts[0].y.toFixed(2)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1.x + (p2.x - p0.x) / 6;
    const c1y = p1.y + (p2.y - p0.y) / 6;
    const c2x = p2.x - (p3.x - p1.x) / 6;
    const c2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${c1x.toFixed(2)},${c1y.toFixed(2)} ${c2x.toFixed(2)},${c2y.toFixed(2)} ${p2.x.toFixed(2)},${p2.y.toFixed(2)}`;
  }
  return d;
};

// === 主组件 ===
export const ActivityChartSection: React.FC<ActivityChartSectionProps> = ({ chartData }) => {
  const { variants } = useAnimationEngine();
  const [hover, setHover] = useState<number | null>(null);
  const wrapperRef = useRef<HTMLDivElement>(null);

  const model = useMemo(() => {
    if (!Array.isArray(chartData) || chartData.length === 0) return null;

    const daily = chartData.map((item: any) => {
      const date = new Date(item.date);
      return { date, count: Number(item.count) || 0 };
    });

    const counts = daily.map((d) => d.count);
    const maxCount = Math.max(...counts, 1);
    const totalCount = counts.reduce((a, b) => a + b, 0);
    const avg = (totalCount / daily.length).toFixed(1);

    // 最长连续提交
    let streak = 0;
    let bestStreak = 0;
    counts.forEach((c) => {
      streak = c > 0 ? streak + 1 : 0;
      bestStreak = Math.max(bestStreak, streak);
    });

    // 峰值日
    const peakIdx = counts.indexOf(maxCount);
    const peak = daily[peakIdx];

    // 平滑波形
    const W = 1000;
    const H = 200;
    const BASE = 186;
    const MAXH = 150;
    const smoothed = smooth(counts);

    const points = smoothed.map((v, i) => ({
      x: (i / (smoothed.length - 1)) * W,
      y: BASE - (v / maxCount) * MAXH,
    }));

    const linePath = buildSmoothPath(points);
    const areaPath =
      points.length > 1
        ? `${linePath} L ${points[points.length - 1].x.toFixed(2)},${BASE} L ${points[0].x.toFixed(2)},${BASE} Z`
        : '';

    // 月份刻度（月份变化处）
    const ticks: { month: string; pct: number; anchor: 'start' | 'middle' | 'end' }[] = [];
    daily.forEach((d, i) => {
      const m = `${d.date.getMonth() + 1}月`;
      const prev = i > 0 ? `${daily[i - 1].date.getMonth() + 1}月` : null;
      if (m !== prev) {
        const pct = i / (daily.length - 1);
        const anchor = i === 0 ? 'start' : 'middle';
        ticks.push({ month: m, pct, anchor });
      }
    });

    return {
      daily,
      counts,
      maxCount,
      totalCount,
      avg,
      bestStreak,
      peak,
      peakIdx,
      points,
      linePath,
      areaPath,
      ticks,
      W,
      H,
      BASE,
    };
  }, [chartData]);

  // hover：根据鼠标位置定位最近的日期索引
  const handleMouseMove = (e: React.MouseEvent) => {
    if (!model || !wrapperRef.current) return;
    const rect = wrapperRef.current.getBoundingClientRect();
    const ratio = Math.min(Math.max((e.clientX - rect.left) / rect.width, 0), 1);
    const idx = Math.round(ratio * (model.daily.length - 1));
    setHover(idx);
  };

  if (!model) {
    return (
      <ChartSection
        initial="hidden"
        whileInView="visible"
        viewport={{ once: true, amount: 0.2 }}
        variants={variants.stagger}
      >
        <SectionHeader>
          <div>
            <SectionTitle variants={variants.fadeIn}>提交频次诗意图谱</SectionTitle>
            <SectionSubtitle variants={variants.fadeIn}>暂无信号</SectionSubtitle>
          </div>
        </SectionHeader>
      </ChartSection>
    );
  }

  const { W, H, BASE } = model;
  const hoverPoint = hover !== null ? model.points[hover] : null;
  const hoverDay = hover !== null ? model.daily[hover] : null;
  const peakPoint = model.points[model.peakIdx];
  const rangeLabel = `${model.daily[0].date.getMonth() + 1}月 - ${
    model.daily[model.daily.length - 1].date.getMonth() + 1
  }月`;

  return (
    <ChartSection
      initial="hidden"
      whileInView="visible"
      viewport={{ once: true, amount: 0.2 }}
      variants={variants.stagger}
    >
      <SectionHeader>
        <div>
          <SectionTitle variants={variants.fadeIn}>提交频次诗意图谱</SectionTitle>
          <SectionSubtitle variants={variants.fadeIn}>
            {rangeLabel} 的编码韵律，每一次提交都化作波形上的涟漪
          </SectionSubtitle>
        </div>

        <StatsRow variants={variants.fadeIn}>
          <StatItem>
            <StatValue>{model.totalCount}</StatValue>
            <StatLabel>总提交</StatLabel>
          </StatItem>
          <StatItem>
            <StatValue>{model.avg}</StatValue>
            <StatLabel>日均</StatLabel>
          </StatItem>
          <StatItem>
            <StatValue>{model.bestStreak}</StatValue>
            <StatLabel>最长连击 / 天</StatLabel>
          </StatItem>
          <StatItem>
            <StatValue>
              {model.peak.date.getMonth() + 1}/{model.peak.date.getDate()}
            </StatValue>
            <StatLabel>峰值 · {model.maxCount} 次</StatLabel>
          </StatItem>
        </StatsRow>
      </SectionHeader>

      <ChartWrapper ref={wrapperRef} onMouseMove={handleMouseMove} onMouseLeave={() => setHover(null)}>
        <SvgChart viewBox={`0 0 ${W} ${H}`} role="img" aria-label="提交频次波形图">
          <defs>
            <linearGradient id="poetic-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" style={{ stopColor: 'var(--accent-color)', stopOpacity: 0.22 }} />
              <stop offset="100%" style={{ stopColor: 'var(--accent-color)', stopOpacity: 0 }} />
            </linearGradient>
          </defs>

          {/* 基线：点状虚线 */}
          <line
            x1="0"
            y1={BASE}
            x2={W}
            y2={BASE}
            style={{ stroke: 'var(--text-secondary-rgb)', strokeOpacity: 0.25 }}
            strokeWidth="1"
            strokeDasharray="2 6"
          />

          {/* 渐变面积 */}
          <motion.path
            d={model.areaPath}
            fill="url(#poetic-area)"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ duration: 1.2, delay: 0.8 }}
          />

          {/* 主波形：外发光层 + 主线 */}
          <motion.path
            d={model.linePath}
            fill="none"
            style={{ stroke: 'var(--accent-color)' }}
            strokeWidth="5"
            strokeOpacity="0.15"
            strokeLinecap="round"
            initial={{ pathLength: 0 }}
            animate={{ pathLength: 1 }}
            transition={{ duration: 2, ease: 'easeInOut' }}
          />
          <motion.path
            d={model.linePath}
            fill="none"
            style={{ stroke: 'var(--accent-color)' }}
            strokeWidth="2"
            strokeLinecap="round"
            initial={{ pathLength: 0 }}
            animate={{ pathLength: 1 }}
            transition={{ duration: 2, ease: 'easeInOut' }}
          />

          {/* 峰值日脉冲标记 */}
          <motion.g
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            transition={{ delay: 2, duration: 0.5 }}
          >
            <motion.circle
              cx={peakPoint.x}
              cy={peakPoint.y}
              r="4"
              animate={{ scale: [1, 1.6, 1] }}
              transition={{ duration: 2.4, repeat: Infinity, ease: 'easeInOut' }}
              style={{ fill: 'var(--accent-color)', transformOrigin: `${peakPoint.x}px ${peakPoint.y}px` }}
            />
            <circle
              cx={peakPoint.x}
              cy={peakPoint.y}
              r="10"
              fill="none"
              style={{ stroke: 'var(--accent-color)' }}
              strokeWidth="1"
              strokeOpacity="0.4"
            />
          </motion.g>

          {/* hover 引导线与锚点 */}
          {hoverPoint && (
            <g>
              <line
                x1={hoverPoint.x}
                y1={hoverPoint.y - 8}
                x2={hoverPoint.x}
                y2={BASE}
                style={{ stroke: 'var(--accent-color)' }}
                strokeWidth="1"
                strokeOpacity="0.4"
                strokeDasharray="3 3"
              />
              <circle
                cx={hoverPoint.x}
                cy={hoverPoint.y}
                r="3.5"
                style={{ fill: 'var(--bg-primary)', stroke: 'var(--accent-color)' }}
                strokeWidth="2"
              />
            </g>
          )}
        </SvgChart>

        {/* hover 浮层 */}
        {hoverPoint && hoverDay && (
          <Tooltip
            initial={{ opacity: 0, y: 4 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ duration: 0.15 }}
            style={{
              left: `${(hoverPoint.x / W) * 100}%`,
              top: `${Math.max((hoverPoint.y / H) * 100 - 18, 0)}%`,
            }}
          >
            {hoverDay.date.getMonth() + 1}/{hoverDay.date.getDate()} ·{' '}
            <span className="count">{hoverDay.count}</span> 次提交
          </Tooltip>
        )}
      </ChartWrapper>

      <MonthTicks>
        {model.ticks.map((tick, i) => (
          <MonthTick key={`${tick.month}-${i}`} pct={tick.pct} anchor={tick.anchor}>
            {tick.month}
          </MonthTick>
        ))}
      </MonthTicks>
    </ChartSection>
  );
};

export default ActivityChartSection;
